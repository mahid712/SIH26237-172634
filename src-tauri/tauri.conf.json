{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../src-ui",
    "distDir": "../src-ui"
  },
  "package": {
    "productName": "PQC Offline Secure Broadcast",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true
      },
      "dialog": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.pqc.offline.broadcast",
      "icon": []
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "PQC Offline Secure Broadcast - Air-Gapped Platform",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
